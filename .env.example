# Local development only. Copy to .env and change the password.
POSTGRES_USER=enso
POSTGRES_PASSWORD=change_me
POSTGRES_DB=enso
POSTGRES_HOST=db
# Published host port. Containers always connect to db:5432.
POSTGRES_PORT=5432

API_PORT=8000
FRONTEND_PORT=5173
# Browser-visible API URL; embedded in the frontend image at build time.
VITE_API_URL=http://localhost:8000/api/v1
# Allowed browser origins, separated by commas (no trailing slash).
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Path INSIDE the ETL container; blank uses /app/data/oni.data.
NOAA_ONI_FILEPATH=
